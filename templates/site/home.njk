{% extends "site/layout.njk" %}
{% from "site/icons.njk" import icon %}

{% macro ticks() %}<svg class="ticks" viewBox="0 0 16 10" aria-hidden="true"><path d="M1 5.5 3.8 8.3 9.5 1.7M6.5 8.3 12.5 1.7" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>{% endmacro %}

{% block content %}

{# ══ Abertura (proposta: centrada, com mostrador de relógio) ═══════ #}
<section class="hero hero--center" aria-labelledby="hero-title">
  <div class="hero__bg" aria-hidden="true">
    <div class="hero__grid-lines"></div>
    <svg class="dial" viewBox="0 0 1200 620" aria-hidden="true">
      <line class="dial__tick dial__tick--h" x1="40.0" y1="600.0" x2="62.0" y2="600.0"/><line class="dial__tick" x1="41.2" y1="563.4" x2="51.2" y2="564.0"/><line class="dial__tick dial__tick--h" x1="44.8" y1="526.9" x2="66.6" y2="529.8"/><line class="dial__tick" x1="50.8" y1="490.7" x2="60.6" y2="492.7"/><line class="dial__tick dial__tick--h" x1="59.1" y1="455.1" x2="80.3" y2="460.8"/><line class="dial__tick" x1="69.7" y1="420.0" x2="79.2" y2="423.2"/><line class="dial__tick dial__tick--h" x1="82.6" y1="385.7" x2="103.0" y2="394.1"/><line class="dial__tick" x1="97.8" y1="352.3" x2="106.7" y2="356.7"/><line class="dial__tick dial__tick--h" x1="115.0" y1="320.0" x2="134.1" y2="331.0"/><line class="dial__tick" x1="134.4" y1="288.9" x2="142.7" y2="294.4"/><line class="dial__tick dial__tick--h" x1="155.7" y1="259.1" x2="173.2" y2="272.5"/><line class="dial__tick" x1="179.0" y1="230.8" x2="186.5" y2="237.4"/><line class="dial__tick dial__tick--h" x1="204.0" y1="204.0" x2="219.6" y2="219.6"/><line class="dial__tick" x1="230.8" y1="179.0" x2="237.4" y2="186.5"/><line class="dial__tick dial__tick--h" x1="259.1" y1="155.7" x2="272.5" y2="173.2"/><line class="dial__tick" x1="288.9" y1="134.4" x2="294.4" y2="142.7"/><line class="dial__tick dial__tick--h" x1="320.0" y1="115.0" x2="331.0" y2="134.1"/><line class="dial__tick" x1="352.3" y1="97.8" x2="356.7" y2="106.7"/><line class="dial__tick dial__tick--h" x1="385.7" y1="82.6" x2="394.1" y2="103.0"/><line class="dial__tick" x1="420.0" y1="69.7" x2="423.2" y2="79.2"/><line class="dial__tick dial__tick--h" x1="455.1" y1="59.1" x2="460.8" y2="80.3"/><line class="dial__tick" x1="490.7" y1="50.8" x2="492.7" y2="60.6"/><line class="dial__tick dial__tick--h" x1="526.9" y1="44.8" x2="529.8" y2="66.6"/><line class="dial__tick" x1="563.4" y1="41.2" x2="564.0" y2="51.2"/><line class="dial__tick dial__tick--h" x1="600.0" y1="40.0" x2="600.0" y2="62.0"/><line class="dial__tick" x1="636.6" y1="41.2" x2="636.0" y2="51.2"/><line class="dial__tick dial__tick--h" x1="673.1" y1="44.8" x2="670.2" y2="66.6"/><line class="dial__tick" x1="709.3" y1="50.8" x2="707.3" y2="60.6"/><line class="dial__tick dial__tick--h" x1="744.9" y1="59.1" x2="739.2" y2="80.3"/><line class="dial__tick" x1="780.0" y1="69.7" x2="776.8" y2="79.2"/><line class="dial__tick dial__tick--h" x1="814.3" y1="82.6" x2="805.9" y2="103.0"/><line class="dial__tick" x1="847.7" y1="97.8" x2="843.3" y2="106.7"/><line class="dial__tick dial__tick--h" x1="880.0" y1="115.0" x2="869.0" y2="134.1"/><line class="dial__tick" x1="911.1" y1="134.4" x2="905.6" y2="142.7"/><line class="dial__tick dial__tick--h" x1="940.9" y1="155.7" x2="927.5" y2="173.2"/><line class="dial__tick" x1="969.2" y1="179.0" x2="962.6" y2="186.5"/><line class="dial__tick dial__tick--h" x1="996.0" y1="204.0" x2="980.4" y2="219.6"/><line class="dial__tick" x1="1021.0" y1="230.8" x2="1013.5" y2="237.4"/><line class="dial__tick dial__tick--h" x1="1044.3" y1="259.1" x2="1026.8" y2="272.5"/><line class="dial__tick" x1="1065.6" y1="288.9" x2="1057.3" y2="294.4"/><line class="dial__tick dial__tick--h" x1="1085.0" y1="320.0" x2="1065.9" y2="331.0"/><line class="dial__tick" x1="1102.2" y1="352.3" x2="1093.3" y2="356.7"/><line class="dial__tick dial__tick--h" x1="1117.4" y1="385.7" x2="1097.0" y2="394.1"/><line class="dial__tick" x1="1130.3" y1="420.0" x2="1120.8" y2="423.2"/><line class="dial__tick is-22" x1="1140.9" y1="455.1" x2="1119.7" y2="460.8"/><line class="dial__tick" x1="1149.2" y1="490.7" x2="1139.4" y2="492.7"/><line class="dial__tick dial__tick--h" x1="1155.2" y1="526.9" x2="1133.4" y2="529.8"/><line class="dial__tick" x1="1158.8" y1="563.4" x2="1148.8" y2="564.0"/><line class="dial__tick dial__tick--h" x1="1160.0" y1="600.0" x2="1138.0" y2="600.0"/>
      <text class="dial__label" x="86.0" y="600.0">00h</text><text class="dial__label" x="236.5" y="236.5">06h</text><text class="dial__label" x="600.0" y="86.0">12h</text><text class="dial__label" x="963.5" y="236.5">18h</text>
      <text class="dial__label is-22" x="1096.5" y="467.0">22h</text>
    </svg>
  </div>

  <div class="container hero__stack">
    <p class="place-pill"><span class="place-pill__dot" aria-hidden="true"></span>Boa Vista - RR</p>
    <h1 class="hero__title split" id="hero-title">
      {{ "Sua empresa perde cliente porque ninguém responde o WhatsApp às 22h." | words | safe }}
    </h1>
    <p class="hero__answer">
      Eu faço o atendimento da sua empresa no WhatsApp funcionar sozinho, de dia e de noite,
      e organizo o que hoje está em planilha e papel.
    </p>

    <form class="pick" data-pick data-wa="{{ contact.whatsapp }}" data-cta>
      <fieldset class="pick__group">
        <legend class="pick__legend">Qual é o seu negócio?</legend>
        {% for item in segments %}
        <label class="pick__chip">
          <input type="radio" name="segmento" id="seg-{{ loop.index }}" value="{{ item.name }}" data-msg="{{ item.pitch }}"{% if loop.first %} checked{% endif %}>
          <span>{{ icon(item.icon) }}{{ item.name }}</span>
        </label>
        {% endfor %}
      </fieldset>
      <div class="pick__actions">
        <a class="btn btn--accent btn--lg" href="{{ waLink }}" target="_blank" rel="noopener" data-pick-link>
          {{ icon("whatsapp") }} Quero meu WhatsApp respondendo sozinho <span class="arrow" aria-hidden="true">→</span>
        </a>
        <a class="btn btn--ghost btn--lg" href="#pacotes">Ver pacotes e preços</a>
      </div>
      <p class="pick__hint">A conversa abre no WhatsApp com o seu tipo de negócio já escrito. Respondo no mesmo dia.</p>
    </form>
  </div>

  <div class="container hero__showcase">
    <div class="stage stage--center" data-stage aria-label="Exemplo: um cliente pergunta às 21h58 e o atendimento automático responde e agenda a consulta" role="img">
      <div class="stage__layer" data-depth="0.4">
        <div class="phone">
          <div class="phone__screen">
            <div class="phone__status" aria-hidden="true">
              <span>21:58</span>
              <span class="phone__icons"><i></i><i></i><i></i><b></b></span>
            </div>
            <div class="phone__bar">
              <span class="phone__back" aria-hidden="true">‹</span>
              <span class="phone__avatar">SE</span>
              <div>
                <div class="phone__name">Sua empresa</div>
                <div class="phone__online">online</div>
              </div>
            </div>
            <div class="chat" data-chat>
              <span class="chat__day">Hoje</span>
              <p class="msg msg--in" data-step="in">Boa noite! Vocês atendem amanhã? Queria marcar uma consulta.<time>21:58</time></p>
              <p class="msg msg--out" data-step="out">Boa noite! Atendemos sim. Amanhã tenho 8h, 10h30 e 15h. Qual fica melhor?<time>21:58 {{ ticks() }}</time></p>
              <p class="msg msg--in" data-step="in">10h30, por favor<time>21:59</time></p>
              <p class="msg msg--out" data-step="out">Pronto! Consulta marcada para amanhã às 10h30. Mando um lembrete 1h antes.<time>21:59 {{ ticks() }}</time></p>
              <span class="typing" data-hidden><span></span><span></span><span></span></span>
            </div>
            <div class="phone__input" aria-hidden="true"><span>Mensagem</span><i></i></div>
          </div>
        </div>
      
      </div>

      <div class="float float--notify" data-depth="1.4" aria-hidden="true">
        <span class="float__avatar">M</span>
        <div>
          <p class="float__title">Marina <time>21:58</time></p>
          <p class="float__text">Vocês atendem amanhã?</p>
        </div>
      </div>

      <div class="float float--slots" data-depth="1.1" aria-hidden="true">
        <p class="float__title">Amanhã</p>
        <div class="slots"><span>08:00</span><span class="is-picked">10:30</span><span>15:00</span></div>
        <p class="float__ok"><span></span>Consulta confirmada</p>
      </div>

      <div class="float float--toggle" data-depth="1.7" aria-hidden="true">
        <span class="toggle"><span></span></span>
        <div>
          <p class="float__title">Atendimento automático</p>
          <p class="float__text">Ligado, inclusive à noite</p>
        </div>
      </div>

      <div class="float float--count" data-depth="1.25" aria-hidden="true">
        <p class="float__text">Respondidas fora do horário</p>
        <p class="float__big">21 <small>esta semana</small></p>
      </div>

    </div>
    <p class="mock-note mock-note--stage mock-note--showcase" aria-hidden="true">Ilustração com dados de exemplo</p>
  </div>

  <div class="container">
    <div class="trust trust--facts">
      <p>Atendo presencialmente em Boa Vista</p>
      <p>Respondo no mesmo dia</p>
      <p>Preço fechado antes de começar</p>
      {% for item in stats %}{% if not (item.value | pending) %}
      <p><b><span data-count="{{ item.value }}">{{ item.value }}</span>{{ item.suffix }}</b> {{ item.label }}</p>
      {% endif %}{% endfor %}
    </div>
  </div>
</section>

{# ══ Não precisa ser assim ══════════════════════════════════════════ #}
<section class="block block--dark why" aria-labelledby="why-title">
  <div class="container">
    <h2 class="sr-only" id="why-title">Por que a Sapará Dev</h2>
    <p class="statement">
      {{ "Não precisa ser assim. Seu cliente manda mensagem, recebe resposta na hora e sai com horário marcado, enquanto você cuida do que importa." | words | safe }}
    </p>

    <ol class="diffs">
      {% for item in differentials %}
      <li class="diff">
        <span class="diff__num">{{ loop.index | pad }}</span>
        <h3 class="diff__title">{{ item.title }}</h3>
        <p class="diff__text">{{ item.text }}</p>
      </li>
      {% endfor %}
    </ol>
  </div>
</section>

{# ══ Na prática (showcase) ══════════════════════════════════════════ #}
<section class="block showcase" aria-labelledby="showcase-title">
  <div class="showcase__glow" aria-hidden="true"></div>
  <div class="container">
    <header class="showcase__head">
      <p class="kicker">Na prática</p>
      <h2 class="title" id="showcase-title">Tudo que chega no WhatsApp, num painel só.</h2>
      <p class="lede">Você vê quem falou, o que foi respondido e o que já está na agenda. Quando precisa de alguém da equipe, a conversa chega para você.</p>
    </header>

    <div class="browser" aria-hidden="true">
      <div class="browser__chrome"><i></i><i></i><i></i><span>painel.suaempresa.com.br</span></div>
      <div class="dash">
        <aside class="dash__list">
          <p class="dash__h">Conversas <em>hoje · 38</em></p>
          <ul>
            <li class="is-on"><span class="av">M</span><div><b>Marina</b><p>10h30, por favor</p></div><time>21:59</time></li>
            <li><span class="av">J</span><div><b>João Pedro</b><p>Vocês aceitam convênio?</p></div><time>21:40</time></li>
            <li><span class="av">A</span><div><b>Ana Clara</b><p>Confirmado, obrigada!</p></div><time>20:12</time></li>
            <li><span class="av">R</span><div><b>Roberto</b><p>Qual o endereço?</p></div><time>19:55</time></li>
            <li><span class="av">L</span><div><b>Luiza</b><p>Tem horário sábado?</p></div><time>18:31</time></li>
          </ul>
        </aside>
        <div class="dash__chat">
          <p class="dash__h">Marina <em>respondida pelo atendimento automático</em></p>
          <div class="dash__msgs">
            <p class="b b--in">Boa noite! Vocês atendem amanhã? Queria marcar uma consulta.</p>
            <p class="b b--out">Boa noite! Atendemos sim. Amanhã tenho 8h, 10h30 e 15h. Qual fica melhor?</p>
            <p class="b b--in">10h30, por favor</p>
            <p class="b b--out">Pronto! Consulta marcada para amanhã às 10h30. Mando um lembrete 1h antes.</p>
          </div>
        </div>
        <aside class="dash__agenda">
          <p class="dash__h">Agenda <em>amanhã</em></p>
          <ul>
            <li><time>08:00</time><span>Roberto Lima</span></li>
            <li class="is-new"><time>10:30</time><span>Marina Souza</span><em>novo</em></li>
            <li><time>14:00</time><span>Ana Clara</span></li>
            <li><time>15:00</time><span class="free">livre</span></li>
          </ul>
          <div class="dash__kpi"><p>Respondidas fora do horário</p><b>21</b></div>
        </aside>
      </div>
      <p class="mock-note">Ilustração com dados de exemplo</p>
    </div>
  </div>
</section>

{# ══ Pacotes ════════════════════════════════════════════════════════ #}
<section class="block block--light" id="pacotes" aria-labelledby="pacotes-title">
  <div class="container">
    <header class="head">
      <p class="kicker">Pacotes</p>
      <h2 class="title" id="pacotes-title">Preço fechado, prazo definido.</h2>
      <p class="lede">Escolha por onde começar. Se o seu caso não couber em nenhum, a gente ajusta no diagnóstico.</p>
    </header>

    <div class="plans">
      {% for plan in packages %}
      <article class="plan{% if loop.first %} plan--featured{% endif %}">
        {% if loop.first %}<p class="plan__badge">Comece por aqui</p>{% endif %}
        <div class="plan__visual" aria-hidden="true">
          {% if plan.slug == "atendimento-whatsapp" %}
          <div class="mock mock--inbox">
            <div class="mock__top"><span>Conversas de hoje</span><span class="mock__live">ao vivo</span></div>
            <ul class="inbox">
              <li><span class="av">M</span><div><b>Marina</b><p>Consulta marcada para amanhã às 10h30.</p></div><em class="chip chip--ok">Agendado</em></li>
              <li><span class="av">J</span><div><b>João Pedro</b><p>Vou chamar alguém da equipe.</p></div><em class="chip chip--human">Equipe</em></li>
              <li><span class="av">A</span><div><b>Ana Clara</b><p>Sua consulta é hoje às 15h. Confirma?</p></div><em class="chip">Lembrete</em></li>
            </ul>
          </div>
          {% elif plan.slug == "site" %}
          <div class="mock mock--browser">
            <div class="browser__bar"><i></i><i></i><i></i><span>suaempresa.com.br</span></div>
            <div class="site-mini">
              <div class="site-mini__nav"><b>Clínica Exemplo</b><span></span><span></span></div>
              <div class="site-mini__hero">
                <p class="site-mini__h">Cuidado de verdade, perto de você.</p>
                <span class="site-mini__btn">Agendar pelo WhatsApp</span>
              </div>
            </div>
          </div>
          {% else %}
          <div class="mock mock--app">
            <div class="app__main">
              <div class="app__kpis">
                <div><p>Abaixo do mínimo</p><b class="warn">3</b></div>
                <div><p>Orçamentos abertos</p><b>12</b></div>
              </div>
              <div class="app__table">
                <div class="row"><span>Luva nitrílica M</span><span class="lvl"><i style="--v:.18"></i></span><em class="chip chip--warn">Repor</em></div>
                <div class="row"><span>Seringa 5 ml</span><span class="lvl"><i style="--v:.62"></i></span><em class="chip">Ok</em></div>
              </div>
            </div>
          </div>
          {% endif %}
          <p class="mock-note" aria-hidden="true">Ilustração com dados de exemplo</p>
        </div>

        <div class="plan__body">
          <h3 class="plan__name">{{ plan.name }}</h3>
          <p class="plan__for">{{ plan.audience }}</p>
          <div class="price">
            <p class="price__main">{{ plan.setup }}</p>
            <p class="price__sub">de implantação + <b>{{ plan.monthly }}</b></p>
            <p class="price__time">{{ plan.deadline }}</p>
          </div>
          <ul class="includes">
            {% for item in plan.includes %}
            <li>{{ item }}</li>
            {% endfor %}
          </ul>
          <a class="btn {% if loop.first %}btn--accent{% else %}btn--dark{% endif %} plan__btn" href="{{ waLinkFor('Oi, Valdeir! Quero saber mais sobre o pacote ' + plan.name + '.') }}" target="_blank" rel="noopener">Quero esse pacote <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </article>
      {% endfor %}
    </div>
    <p class="plans__foot">A implantação é paga em duas partes: 50% para começar e 50% na entrega.</p>
  </div>
</section>

{# ══ Como funciona ══════════════════════════════════════════════════ #}
<section class="block block--dark process" aria-labelledby="processo-title">
  <div class="container process__grid">
    <header class="process__head">
      <p class="kicker">Como funciona</p>
      <h2 class="title" id="processo-title">Da primeira conversa à manutenção.</h2>
      <p class="lede">Você sabe o preço antes de começar e acompanha cada etapa.</p>
      <p class="process__count" aria-hidden="true"><span data-step-current>01</span> / {{ steps.length | pad }}</p>
    </header>

    <ol class="steps" data-steps>
      <span class="steps__rail" aria-hidden="true"><span class="steps__fill"></span></span>
      {% for step in steps %}
      <li class="step" data-step-item="{{ loop.index | pad }}">
        <span class="step__num">{{ loop.index | pad }}</span>
        <h3 class="step__title">{{ step.title }}</h3>
        <p class="step__text">{{ step.text }}</p>
      </li>
      {% endfor %}
    </ol>
  </div>
</section>

{# ══ Cases ══════════════════════════════════════════════════════════ #}
<section class="block block--dark cases-block" aria-labelledby="cases-title">
  <div class="container">
    <header class="head head--split">
      <div>
        <p class="kicker">Cases</p>
        <h2 class="title" id="cases-title">Sistemas que já estão rodando.</h2>
      </div>
      <a class="link link--light" href="/cases/">Ver todos os cases <span class="arrow" aria-hidden="true">→</span></a>
    </header>

    <div class="cases">
      {# Case sem `metric` aparece sem o número; preencha em src/site-data.ts #}
      {% for item in cases %}
      <article class="case case--{{ item.slug }}" data-spotlight data-inview>
        <div class="case__visual" aria-hidden="true">
          {% if item.slug == "logisticaapp" %}
          <svg class="route" viewBox="0 0 400 240" preserveAspectRatio="xMidYMid slice">
            <g class="route__streets"><path d="M0 60H400M0 130H400M0 200H400M70 0V240M170 0V240M270 0V240M350 0V240M0 20 400 230"/></g>
            <path id="route-path" class="route__path" d="M48 196 C 110 196, 120 130, 170 130 S 240 60, 300 60 S 360 110, 352 150"/>
            <circle class="route__pin" cx="48" cy="196" r="6"/>
            <circle class="route__pin route__pin--end" cx="352" cy="150" r="7"/>
            <circle class="route__truck" r="5"><animateMotion dur="5s" repeatCount="indefinite" rotate="auto"><mpath href="#route-path"/></animateMotion></circle>
          </svg>
          <div class="route__card"><b>Entrega 0142</b><p>Saiu para entrega</p></div>
          <p class="mock-note" aria-hidden="true">Ilustração com dados de exemplo</p>
          {% elif item.slug == "atendimento-whatsapp" %}
          <div class="bubbles">
            <p class="b b--in">Tem horário sábado?</p>
            <p class="b b--out">Tenho sim! 9h ou 11h?</p>
            <p class="b b--in">11h</p>
            <p class="b b--out">Agendado ✓ Te lembro na sexta.</p>
          </div>
          <p class="mock-note" aria-hidden="true">Ilustração com dados de exemplo</p>
          {% elif item.slug == "recapi" %}
          <div class="cams">
            {% for n in range(0, 12) %}
            <span class="cam" style="--d:{{ n }}"><i>CAM {{ (n + 1) | pad }}</i></span>
            {% endfor %}
          </div>
          <p class="mock-note" aria-hidden="true">Ilustração com dados de exemplo</p>
          {% elif item.slug == "robo-juridico" %}
          <div class="robot">
            <div class="robot__head"><span>Acompanhamento de processos</span><span class="mock__live">consultando</span></div>
            <ul class="robot__list">
              <li><em class="tag">e-SAJ</em><span class="robot__num">1000xxx-xx.2026.8.26.0100</span><b class="chip chip--ok">Nova intimação</b></li>
              <li><em class="tag">eproc</em><span class="robot__num">5001xxx-xx.2026.8.26.0224</span><b class="chip">Movimentação</b></li>
              <li><em class="tag">e-SAJ</em><span class="robot__num">1002xxx-xx.2026.8.26.0053</span><b class="chip">Sem novidade</b></li>
            </ul>
          </div>
          <p class="mock-note" aria-hidden="true">Ilustração com dados de exemplo</p>
          {% endif %}
        </div>

        <div class="case__body">
          {% if not (item.sector | pending) %}<p class="case__sector">{{ item.sector }}</p>{% endif %}
          <h3 class="case__name">{{ item.name }}</h3>
          {% if not (item.metric | pending) %}<p class="case__metric">{{ item.metric }}</p>{% endif %}
          <p class="case__desc">{{ item.metricLabel }}</p>
          {% if not (item.origin | pending) %}<p class="case__origin">{{ item.origin }}</p>{% endif %}
          <a class="case__link" href="{{ item.url }}">Ver case <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

{# ══ Para quem ══════════════════════════════════════════════════════ #}
<section class="block block--light who" aria-labelledby="who-title">
  <div class="container">
    <header class="head">
      <p class="kicker">Para quem eu trabalho</p>
      <h2 class="title" id="who-title">Negócios que vivem de atendimento.</h2>
    </header>
    <ul class="who__list">
      {% for item in segments %}
      <li class="who__row">
        <span class="who__icon">{{ icon(item.icon) }}</span>
        <span class="who__name">{{ item.name }}</span>
        <span class="who__need">{{ item.text }}</span>
      </li>
      {% endfor %}
    </ul>
    <p class="who__more">E outras pequenas empresas de Boa Vista.</p>
  </div>
</section>

{# ══ Do blog ════════════════════════════════════════════════════════ #}
{% if recentPosts.length %}
<section class="block block--light blog-block" aria-labelledby="blog-title">
  <div class="container">
    <header class="head head--split">
      <div>
        <p class="kicker">Do blog</p>
        <h2 class="title title--sm" id="blog-title">Como eu resolvo problemas reais.</h2>
      </div>
      <a class="link" href="/blog/">Ver todos os posts <span class="arrow" aria-hidden="true">→</span></a>
    </header>
    <div class="posts">
      {% for post in recentPosts %}
      <a class="post" href="{{ post.url }}">
        <time datetime="{{ post.dateString }}">{{ post.dateLong }}</time>
        <span class="post__title">{{ post.title }}</span>
        {% if post.description %}<span class="post__desc">{{ post.description }}</span>{% endif %}
        <span class="post__go" aria-hidden="true">→</span>
      </a>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{# ══ Quem faz (proposta: foto + compromisso pessoal) ═══════════════ #}
<section class="block block--light person" aria-labelledby="maker-title">
  <div class="container person__grid">
    <figure class="person__photo">
      {# FOTO: maker.photo em src/site-data.ts (vertical 4:5) #}
      {% if not (maker.photo | pending) %}
      <img src="{{ maker.photo }}" alt="{{ maker.photoAlt }}" width="480" height="600" loading="lazy" decoding="async">
      {% else %}
      <div class="maker__photo--placeholder" role="img" aria-label="Foto de Valdeir Sapará"></div>
      {% endif %}
      <figcaption class="person__tag">
        <span class="person__mark" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 2 22 12 12 22 2 12z" fill="currentColor"/><path d="M12 7.5 16.5 12 12 16.5 7.5 12z" fill="#111"/></svg></span>
        <span><b>Valdeir Sapará</b><small>Sapará Dev · Boa Vista - RR</small></span>
      </figcaption>
    </figure>

    <div class="person__copy">
      <p class="kicker">Quem faz</p>
      <h2 class="title" id="maker-title">Valdeir Sapará, quem desenvolve o seu projeto.</h2>
      <p class="person__lede">Aqui não tem gerente de conta nem call center. Quem conversa com você, entende o problema, desenvolve e cuida do sistema depois sou eu. Atendo pessoalmente em Boa Vista.</p>

      <ul class="promises">
        <li>
          <span class="promises__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-5.6-7-11a7 7 0 0 1 14 0c0 5.4-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg></span>
          <div><b>Vou até a sua empresa</b><p>O diagnóstico é feito no seu balcão, vendo como o atendimento acontece hoje.</p></div>
        </li>
        <li>
          <span class="promises__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 19.5l1.1-3.6A8 8 0 1 1 8.4 18.6z"/></svg></span>
          <div><b>Você fala direto comigo</b><p>Do primeiro orçamento ao suporte, no mesmo WhatsApp. Respondo no mesmo dia.</p></div>
        </li>
        <li>
          <span class="promises__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4.5 6v5.5c0 4.6 3.2 8.4 7.5 9.5 4.3-1.1 7.5-4.9 7.5-9.5V6z"/><path d="m9 12 2 2 4-4"/></svg></span>
          <div><b>Continuo cuidando depois da entrega</b><p>Treino sua equipe e faço a manutenção todo mês, com suporte e backup.</p></div>
        </li>
      </ul>

      <div class="person__actions">
        <a class="btn btn--dark btn--lg" href="{{ waLinkFor('Oi, Valdeir! Vim pelo site e queria conversar sobre um projeto.') }}" target="_blank" rel="noopener">{{ icon("whatsapp") }} Falar comigo no WhatsApp <span class="arrow" aria-hidden="true">→</span></a>
        <a class="link" href="/sobre/">Conhecer minha trajetória <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>
</section>

{# ══ CTA final ══════════════════════════════════════════════════════ #}
<section class="final" aria-labelledby="cta-title">
  <div class="final__glow" aria-hidden="true"></div>
  <div class="container final__inner">
    <h2 class="final__title" id="cta-title">Bora conversar?</h2>
    <p class="final__text">Me conta o que está travando na sua empresa. Respondo no mesmo dia.</p>
    <div class="final__actions" data-cta>
      <a class="btn btn--accent btn--xl" href="{{ waLink }}" target="_blank" rel="noopener">
        {{ icon("whatsapp") }} Falar no WhatsApp <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

{% endblock %}
