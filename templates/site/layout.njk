{% from "site/icons.njk" import icon %}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDescription }}">
  <meta name="theme-color" content="#111111">
  <link rel="canonical" href="{{ canonicalUrl }}">
  <meta property="og:type" content="website">
  <meta property="og:locale" content="pt_BR">
  <meta property="og:site_name" content="Sapará Dev">
  <meta property="og:title" content="{{ ogTitle or pageTitle }}">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:url" content="{{ canonicalUrl }}">
  <meta name="google-site-verification" content="eToCwvJhbDQS7RI7zJwMDvgoPcgfgHxmyFyKyEnjLHc" />
  <link rel="icon" href="/favicon.ico?v=4" sizes="32x32">
  <link rel="icon" href="/favicon.svg?v=4" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=4">
  <link rel="alternate" type="application/rss+xml" title="Blog da Sapará Dev" href="/feed.xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap">
  <link rel="stylesheet" href="/site.css?v={{ assetVersion }}">
  <script>
    (function (d) {
      d.classList.add("js");
      // Movimento orquestrado pelo GSAP: só quando a pessoa não pediu menos movimento.
      // Se o GSAP não carregar em 2,5 s, a página volta para as animações em CSS.
      if (window.matchMedia("(prefers-reduced-motion: no-preference)").matches) {
        d.classList.add("motion");
        setTimeout(function () { if (!window.gsap) d.classList.remove("motion"); }, 4000);
      }
    })(document.documentElement);
  </script>
  {# GSAP 3.13: todos os plugins são gratuitos (ScrollSmoother, SplitText, DrawSVG) #}
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.13.0/gsap.min.js" defer></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.13.0/ScrollTrigger.min.js" defer></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.13.0/ScrollSmoother.min.js" defer></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.13.0/SplitText.min.js" defer></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.13.0/DrawSVGPlugin.min.js" defer></script>
  <script src="/site.js?v={{ assetVersion }}" defer></script>
  <script src="/motion.js?v={{ assetVersion }}" defer></script>
  <script type="application/ld+json">{{ schemaJson | safe }}</script>
</head>
<body class="site {{ bodyClass }}">
  <a class="skip" href="#conteudo">Pular para o conteúdo</a>

  <header class="header">
    <div class="container header__inner">
      <a class="logo" href="/" aria-label="Sapará Dev, página inicial">
        <svg class="logo__mark" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2 22 12 12 22 2 12z" fill="currentColor"/><path d="M12 7.5 16.5 12 12 16.5 7.5 12z" fill="#111"/></svg>
        <span>Sapará<span class="logo__dev"> Dev</span></span>
      </a>

      <nav class="nav" aria-label="Principal">
        <a href="/servicos/"{% if navActive == "servicos" %} aria-current="page"{% endif %}>Serviços</a>
        <a href="/cases/"{% if navActive == "cases" %} aria-current="page"{% endif %}>Cases</a>
        <a href="/sobre/"{% if navActive == "sobre" %} aria-current="page"{% endif %}>Sobre</a>
        <a href="/blog/"{% if navActive == "blog" %} aria-current="page"{% endif %}>Blog</a>
      </nav>

      <div class="header__actions">
        <a class="btn btn--light btn--sm" href="{{ waLink }}" target="_blank" rel="noopener" data-cta>
          {{ icon("whatsapp") }}<span class="hide-xs">Falar no WhatsApp</span><span class="show-xs">WhatsApp</span>
        </a>
        <button class="menu-btn" type="button" aria-expanded="false" aria-controls="menu-mobile" aria-label="Abrir menu"><span></span></button>
      </div>
    </div>
    <nav class="mobile-nav" id="menu-mobile" aria-label="Menu" hidden>
      <div class="container">
        <a href="/servicos/">Serviços <span aria-hidden="true">→</span></a>
        <a href="/cases/">Cases <span aria-hidden="true">→</span></a>
        <a href="/sobre/">Sobre <span aria-hidden="true">→</span></a>
        <a href="/blog/">Blog <span aria-hidden="true">→</span></a>
        <a href="/contato/">Contato <span aria-hidden="true">→</span></a>
      </div>
    </nav>
  </header>

  {# ScrollSmoother: tudo que rola fica dentro destes dois wrappers;
     o topo fixo e o botão flutuante ficam de fora. #}
  <div id="smooth-wrapper">
  <div id="smooth-content">
  <main id="conteudo">
    {% block content %}{% endblock %}
  </main>

  <footer class="footer">
    <div class="container">
      <div class="footer__grid">
        <div class="footer__col footer__about">
          <p class="footer__pitch">Atendimento no WhatsApp, sites e sistemas para empresas de Boa Vista.</p>
        </div>
        <div class="footer__col">
          <p class="footer__title">Contato</p>
          <a href="{{ waLink }}" target="_blank" rel="noopener">WhatsApp {{ contact.whatsappDisplay }}</a>
          <a href="mailto:{{ contact.email }}">{{ contact.email }}</a>
          {# Instagram: preencha contact.instagram e contact.instagramUrl em src/site-data.ts #}
          {% if not (contact.instagram | pending) %}<a href="{{ contact.instagramUrl }}" target="_blank" rel="noopener">Instagram {{ contact.instagram }}</a>{% endif %}
          <span>Atendo em {{ contact.city }}</span>
        </div>
        <div class="footer__col">
          <p class="footer__title">Páginas</p>
          <a href="/servicos/">Serviços</a>
          <a href="/cases/">Cases</a>
          <a href="/sobre/">Sobre</a>
          <a href="/blog/">Blog</a>
          <a href="/contato/">Contato</a>
        </div>
      </div>
      <div class="footer__bottom">
        {# CNPJ: [[PREENCHER]] — coloque o número em contact.cnpj (src/site-data.ts).
           Enquanto estiver vazio, nada aparece aqui; depois de preenchido, a linha
           "© Sapará Dev · CNPJ 00.000.000/0000-00" aparece sozinha. #}
        <span>© {{ buildYear }} Sapará Dev{% if not (contact.cnpj | pending) %} · CNPJ {{ contact.cnpj }}{% endif %}</span>
        <a href="/feed.xml">RSS do blog</a>
      </div>
    </div>
    <p class="wordmark" aria-hidden="true">Sapará Dev</p>
  </footer>
  </div>
  </div>

  <a class="wa-float is-hidden" href="{{ waLink }}" target="_blank" rel="noopener" aria-label="Falar no WhatsApp">
    {{ icon("whatsapp") }}
  </a>
</body>
</html>
